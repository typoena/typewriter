# Rust / Cargo
/target/
**/target/
Cargo.lock.bak
*.rs.bk
# The host workspace is libraries only (no shipped binary), so its lock floats
# rather than being pinned in git — matching the per-crate convention it replaces.
/Cargo.lock

# esp-idf / embedded build artifacts
/build/
**/build/
sdkconfig
sdkconfig.old
sdkconfig.defaults.*.bak
.embuild/
managed_components/
dependencies.lock

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Local config and secrets
.env
.env.local
*.local.toml
config.local.*

# Logs and temp
*.log
*.tmp
.nuke-comments-backup/

# Node tooling
node_modules/

# Python tooling (display/tools: typogen.py, fontgen.py)
__pycache__/
*.pyc

# Typoena website — its own git repo (git.apoena.dev/julien/typoena-site),
# nested here for co-location but deployed independently. Keep it out of the
# firmware tree.
/typoena-site/

# KiCad (hardware/pcb) — sources are tracked (.kicad_sch/.kicad_pcb/.kicad_pro,
# the lib tables, and the generated Gerbers so the board can be ordered from a
# checkout). Everything below is per-machine state or regenerable output.
*.kicad_prl
*.kicad_pcb-bak
# KiCad's local history: a snapshot per save, tens of MB, and git already does
# this job better.
.history/
# Lock files written while a KiCad editor holds the document open.
~*.lck
# LibreOffice lock, if the exported BOM gets opened from the repo.
.~lock.*#
*.kicad_sch-bak
*-backups/
_autosave-*
fp-info-cache
*_drc_violations.json
*-drc.rpt
*-erc.rpt
# Intermediate netlist: KiCad regenerates it from the schematic on demand.
hardware/pcb/**/*.net

# Fabrication outputs: kicad-cli regenerates them from the .kicad_pcb, and the
# board file is the record of what was sent.
hardware/pcb/**/fab/
