# Typoena enclosure — 3D-printed case
# Run from the hardware/ directory (just sets cwd here automatically).

scad := "case/typoena-case.scad"

# integrated-keyboard variant (see case/README-kb.md). kb and W must move as a
# pair — the model asserts they match:  60% -> 291.30   40% -> 239.15
scad_kb := "typoena-case-kb.scad"
kb60    := "-D 'kb=\"60\"' -D 'W=291.30'"
kb40    := "-D 'kb=\"40\"' -D 'W=239.15'"

# shared OpenSCAD flags (everything but the camera + the part to show).
# $fn is pinned here so preview quality is stable no matter what the file's
# editing value is set to.
base    := "--imgsize=1100,825 --colorscheme=Tomorrow --viewall --autocenter -D '$fn=48'"
# the standard 3/4 camera used by most previews (rotate 62° tilt, 22° azimuth)
std_cam := "--camera=0,0,0,62,0,22,0"

# list available recipes
default:
    @just --list

# open the case model in OpenSCAD
open:
    open -a OpenSCAD {{scad}}

# regenerate every preview PNG in case/renders/
render:
    cd case && openscad -o renders/assembled.png  {{base}} {{std_cam}} -D 'show="assembled"'   typoena-case.scad
    cd case && openscad -o renders/body.png       {{base}} {{std_cam}} -D 'show="body"'        typoena-case.scad
    cd case && openscad -o renders/bracket.png    {{base}} {{std_cam}} -D 'show="bracket"'     typoena-case.scad
    cd case && openscad -o renders/baseplate.png  {{base}} {{std_cam}} -D 'show="baseplate"'   typoena-case.scad
    cd case && openscad -o renders/print.png      {{base}} {{std_cam}} -D 'show="print_plate"' typoena-case.scad
    cd case && openscad -o renders/section.png    {{base}} {{std_cam}} -D 'show="section"'     typoena-case.scad
    cd case && openscad -o renders/plan.png       {{base}} {{std_cam}} -D 'show="plan"'        typoena-case.scad
    cd case && openscad -o renders/plan-up.png    {{base}} {{std_cam}} -D 'show="plan_up"'     typoena-case.scad
    cd case && openscad -o renders/plan-down.png  {{base}} {{std_cam}} -D 'show="plan_down"'   typoena-case.scad
    # two bespoke cameras: the straight-on nameplate hero, and the low back 3/4
    cd case && openscad -o renders/nameplate.png  {{base}} --camera=0,0,0,62,0,0,0   -D 'show="body"'      typoena-case.scad
    cd case && openscad -o renders/front34.png    {{base}} --camera=0,0,0,72,0,200,0 -D 'show="assembled"' typoena-case.scad
    # the I/O fit coupon, straight down on its face
    cd case && openscad -o renders/io-coupon.png  {{base}} --camera=0,0,0,0,0,0,0    -D 'show="io_coupon"' typoena-case.scad
    # back elevation, lightly tilted — for judging how the I/O sits on the face
    cd case && openscad -o renders/back.png       {{base}} --camera=0,0,0,80,0,180,0 -D 'show="assembled"'    typoena-case.scad

# regenerate the integrated-keyboard variant previews (60% + 40%)
render-kb:
    cd case && openscad -o renders/kb60-assembled.png {{base}} {{std_cam}} {{kb60}} -D 'show="kb_assembled"' {{scad_kb}}
    cd case && openscad -o renders/kb60-body.png      {{base}} {{std_cam}} {{kb60}} -D 'show="kb_body"'      {{scad_kb}}
    cd case && openscad -o renders/kb60-section.png   {{base}} --camera=0,0,0,90,0,90,0  {{kb60}} -D 'show="kb_section"'   {{scad_kb}}
    cd case && openscad -o renders/kb60-back.png      {{base}} --camera=0,0,0,72,0,200,0 {{kb60}} -D 'show="kb_assembled"' {{scad_kb}}
    cd case && openscad -o renders/kb40-assembled.png {{base}} {{std_cam}} {{kb40}} -D 'show="kb_assembled"' {{scad_kb}}
    cd case && openscad -o renders/kb40-body.png      {{base}} {{std_cam}} {{kb40}} -D 'show="kb_body"'      {{scad_kb}}

# export the integrated-keyboard variant STLs (bracket is shared — see `stl`)
stl-kb:
    cd case && openscad -o kb60-body.stl      {{kb60}} -D 'show="kb_body"'      {{scad_kb}}
    cd case && openscad -o kb60-baseplate.stl {{kb60}} -D 'show="kb_baseplate"' {{scad_kb}}
    cd case && openscad -o kb40-body.stl      {{kb40}} -D 'show="kb_body"'      {{scad_kb}}
    cd case && openscad -o kb40-baseplate.stl {{kb40}} -D 'show="kb_baseplate"' {{scad_kb}}
    cd case && zip -qj stl-kb.zip kb60-body.stl kb60-baseplate.stl kb40-body.stl kb40-baseplate.stl

# export STLs: 3 printable parts + the full-assembly reference, then bundle
# the printable parts into stl.zip for handoff
stl:
    cd case && openscad -o body.stl         -D 'show="body"'      typoena-case.scad
    cd case && openscad -o bracket.stl      -D 'show="bracket"'   typoena-case.scad
    cd case && openscad -o baseplate.stl    -D 'show="baseplate"' typoena-case.scad
    cd case && openscad -o typoena-case.stl -D 'show="assembled"' typoena-case.scad
    cd case && zip -qj stl.zip body.stl bracket.stl baseplate.stl

# export just the back-wall I/O fit coupon (quick test print before the body)
stl-io:
    cd case && openscad -o io-coupon.stl -D 'show="io_coupon"' typoena-case.scad
